# Copy to server/.env and fill in. server/.env is git-ignored.

# Free key: https://aistudio.google.com (the workshop's toolkit)
GEMINI_API_KEY=

# Optional: the workshop uses gemini-2.5-flash. Check
# https://aistudio.google.com/docs/models for the current free Flash model.
# GEMINI_MODEL=gemini-2.5-flash

# Test modes. FAKE_AI=1 runs without a key (sample notes and scripts).
# FAKE_TTS=1 skips Kokoro and makes quiet tones instead of voices.
# FAKE_AI=1
# FAKE_TTS=1

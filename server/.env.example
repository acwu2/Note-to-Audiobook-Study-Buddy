# Copy to server/.env and fill in. server/.env is git-ignored.

# Free key: https://aistudio.google.com/apikey (the workshop's toolkit).
# Leave it empty until you have one: server/check_setup.py treats any value as "set",
# so a placeholder like your-key-here would hide that the key is missing.
GEMINI_API_KEY=

# Optional. gemini-2.5-flash is retired for new keys (404 "no longer available
# to new users") even though ListModels still shows it. Verified working:
# gemini-3.5-flash, gemini-3.8-flash. The free tier allows 20 requests per day
# PER MODEL, so switching model gives a fresh allowance.
# GEMINI_MODEL=gemini-3.5-flash

# Test modes. FAKE_AI=1 runs without a key (sample notes and scripts).
# FAKE_TTS=1 skips Kokoro and makes quiet tones instead of voices.
# FAKE_AI=1
# FAKE_TTS=1
